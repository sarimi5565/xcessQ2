  {
    "id": "SM0150005",
    "course": "SM015",
    "topic": "Differentiation",
    "subtopic": "Differentiation involving partial fraction",
    "difficulty": "Hard",
    "question": {
      "type": "latex",
      "content": "By expressing $~~~y=\\dfrac{1}{(x-1)^2(x-3)}~~~$ into partial fraction, find $\\dfrac{dy}{dx}$ and $\\dfrac{d^2y}{dx^2}$. $~~$\nGive your answer in the simplest form. $$$$\nHence, evaluate  $\\dfrac{d^2y}{dx^2}$  when $x=-1$.",
      "images": []
    },
    "answer": {
      "type": "latex",
      "content": "$$y=-\\frac{1}{4(x-1)}-\\frac{1}{2(x-1)^2}+\\frac{1}{4(x-3)}$$\n$$\\frac{dy}{dx}=\\frac{1}{4(x-1)^2}+\\frac{1}{(x-1)^3}-\\frac{1}{4(x-3)^2}$$\n$$\\frac{d^2y}{dx^2}=-\\frac{1}{2(x-1)^3}-\\frac{3}{(x-1)^4}+\\frac{1}{2(x-3)^3}$$\n$$\\frac{d^2y}{dx^2}|_{x=-1}=-\\frac{17}{128}$$",
      "images": [],
      "youtube": "https://www.youtube.com/watch?v=KH8mZwhUlps"
    },
    "tags": [
      "differentiation",
      "partial fraction",
      "first",
      "second",
      "derivative"
    ],
    "createdAt": "2026-09-06T03:55:43.696Z"
  },
